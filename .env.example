# Environment Variables Template for Janatha Syrup
# Rename or copy this to .env for local testing, or add to Vercel/Netlify Dashboard

# Security
SECRET_KEY=your-super-secret-django-key-here-replace-in-production
DEBUG=False
ALLOWED_HOSTS=.vercel.app,.netlify.app,localhost,127.0.0.1

# Supabase PostgreSQL Database URL
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:your_password@db.your_supabase_ref.supabase.co:5432/postgres

# CSRF Trusted Origins
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://*.netlify.app,http://localhost:8000
